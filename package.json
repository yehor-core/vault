{
  "name": "vault",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "demo": "vite demo",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "check:refs": "node scripts/check-test-refs.ts",
    "check:decisions": "node scripts/check-decisions.ts",
    "lint": "oxlint",
    "break-check": "node scripts/break-check.ts",
    "test": "npm run test:scripts && npm run test:unit && npm run test:e2e",
    "test:scripts": "node --test scripts/*.test.ts",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@vitest/browser-playwright": "5.1.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxlint": "1.93.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
